{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=eventManagerBookings;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "EventManagerDevelopmentSecretKeyForJwtTokens",
    "Issuer": "EventManager",
    "Audience": "EventManagerClients",
    "LifetimeMinutes": 60,
    "RefreshLifetimeDays": 7
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "bookings-service"
  },
  "AllowedHosts": "*"
}
