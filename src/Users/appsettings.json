{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=users;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "EventManagerDevelopmentSecretKeyForJwtTokens",
    "Issuer": "EventManager",
    "Audience": "EventManagerClients",
    "LifetimeMinutes": 60,
    "RefreshLifetimeDays": 7
  },
  "Service": {
    "Name": "users-service"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
